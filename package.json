{
  "name": "loyaltytracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-zxing-wasm.mjs",
    "dev": "next dev",
    "build": "node scripts/copy-zxing-wasm.mjs && prisma generate && next build",
    "start": "prisma migrate deploy && next start -p $PORT",
    "lint": "eslint",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "onboard:business": "tsx --env-file=.env scripts/create-business.ts",
    "onboard:platform-admin": "tsx --env-file=.env scripts/create-platform-admin.ts",
    "send-expiry-reminders": "tsx --env-file=.env scripts/send-expiry-reminders.ts",
    "send-winback-nudges": "tsx --env-file=.env scripts/send-winback-nudges.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "barcode-detector": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
