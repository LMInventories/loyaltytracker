// Prisma schema for HPLoyalty
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  BUSINESS_ADMIN
  PLATFORM_ADMIN
}

enum SchemeType {
  POINTS
  STAMPS
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  // Null for accounts created via an OAuth provider only (e.g. Google).
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  name          String?
  role          Role      @default(CUSTOMER)
  // Geocoded from `postcode` via postcodes.io when the customer sets it —
  // used to sort the business directory by distance.
  postcode      String?
  latitude      Float?
  longitude     Float?
  emailNotificationsEnabled Boolean @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Set only for BUSINESS_ADMIN users (v1: one admin per business)
  businessId   String?
  business     Business? @relation("BusinessAdmins", fields: [businessId], references: [id])

  accounts     Account[]
  balances     LoyaltyBalance[]
  transactions LoyaltyTransaction[]
  redeemedTokens QrToken[]           @relation("RedeemedBy")
  rewardRedemptions RewardRedemption[]

  @@index([businessId])
}

/// OAuth provider links (e.g. Google), used by the Auth.js Prisma adapter.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  logoUrl     String?
  address     String?
  // Geocoded via postcodes.io when set — used to sort the directory by
  // distance from a customer's postcode. Independent of `address`, which
  // stays free text for display.
  postcode    String?
  latitude    Float?
  longitude   Float?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admins       User[]                @relation("BusinessAdmins")
  schemes      LoyaltyScheme[]
  offers       SpecialOffer[]
  qrTokens     QrToken[]
  balances     LoyaltyBalance[]
  transactions LoyaltyTransaction[]
  rewardRedemptions RewardRedemption[]
}

model LoyaltyScheme {
  id       String     @id @default(cuid())
  name     String
  type     SchemeType
  isActive Boolean    @default(true)

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  // POINTS-type config
  pointsPerScan Int?

  // STAMPS-type config
  stampsRequired      Int?
  stampRewardText     String?
  stampRewardImageUrl String?

  // Days an unlocked reward stays redeemable before it expires. Null = never
  // expires. Set per scheme by the business; applies to every reward it unlocks
  // (a POINTS tier crossing or a STAMPS card completion).
  rewardExpiryDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rewardTiers       RewardTier[]
  balances          LoyaltyBalance[]
  transactions      LoyaltyTransaction[]
  qrTokens          QrToken[]
  rewardRedemptions RewardRedemption[]

  @@index([businessId])
}

model RewardTier {
  id         String        @id @default(cuid())
  schemeId   String
  scheme     LoyaltyScheme @relation(fields: [schemeId], references: [id])
  threshold  Int
  rewardText String
  imageUrl   String?
  sortOrder  Int           @default(0)

  redemptions RewardRedemption[]

  @@index([schemeId])
}

model SpecialOffer {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id])
  title       String
  description String?
  imageUrl    String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([businessId])
}

/// Cached balance per user per scheme, updated only inside the redeem transaction.
model LoyaltyBalance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  schemeId String
  scheme   LoyaltyScheme @relation(fields: [schemeId], references: [id])

  points    Int      @default(0)
  // Resets to the leftover (usually 0) each time it crosses stampsRequired —
  // the reward that crossing grants is persisted separately as a
  // RewardRedemption, independent of this counter.
  stamps    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([userId, schemeId])
  @@index([businessId])
}

/// Immutable audit log of every redeemed scan. Source of truth for balances.
model LoyaltyTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  schemeId String
  scheme   LoyaltyScheme @relation(fields: [schemeId], references: [id])

  qrTokenId String?  @unique
  qrToken   QrToken? @relation(fields: [qrTokenId], references: [id])

  pointsDelta Int      @default(0)
  stampsDelta Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([userId, businessId])
}

/// Short-lived, single-use redemption token displayed by the admin/staff device
/// and scanned by the customer's app. `code` is a random opaque string — it does
/// NOT encode business/scheme/points info, which is looked up server-side.
model QrToken {
  id     String @id @default(cuid())
  code   String @unique

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  schemeId String
  scheme   LoyaltyScheme @relation(fields: [schemeId], references: [id])

  pointsValue Int?
  stampsValue Int? @default(1)

  expiresAt    DateTime
  redeemedAt   DateTime?
  redeemedById String?
  redeemedBy   User?     @relation("RedeemedBy", fields: [redeemedById], references: [id])

  createdAt   DateTime             @default(now())
  transaction LoyaltyTransaction?

  @@index([businessId, expiresAt])
}

/// A specific reward a user has earned (a POINTS tier crossing, or one
/// completion of a STAMPS card) and can redeem in person. `redeemedAt` is set
/// atomically the moment the customer slides to redeem it — from then on it's
/// considered claimed, shown to staff as proof.
model RewardRedemption {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  schemeId String
  scheme   LoyaltyScheme @relation(fields: [schemeId], references: [id])

  // Set for a POINTS-scheme reward; null for a STAMPS-scheme reward (which has
  // no tier — it's the scheme's single stampRewardText, granted repeatedly).
  rewardTierId String?
  rewardTier   RewardTier? @relation(fields: [rewardTierId], references: [id])

  // Snapshot of the reward's text at unlock time, so editing the scheme/tier
  // later doesn't change what an already-unlocked reward says.
  rewardText String

  unlockedAt DateTime  @default(now())
  expiresAt  DateTime?
  redeemedAt DateTime?
  // Set once the expiring-soon reminder email has been sent (or would have
  // been, for an opted-out user) so the daily cron never re-evaluates it.
  expiryReminderSentAt DateTime?

  @@index([userId, businessId])
  @@index([schemeId])
  @@index([expiresAt, expiryReminderSentAt])
}
